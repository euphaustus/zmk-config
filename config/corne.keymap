#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define QWERTY 0
#define GAMING 1
#define SYMBOL 2
#define NAV 3
#define ADJUST 4

/ {

  
  chosen {
    zmk,matrix-transform = &default_transform;
  };


   conditional_layers {
       compatible = "zmk,conditional-layers";
       adjust_layer {
           if-layers = <SYMBOL NAV>;
           then-layer = <ADJUST>;
       };
   };

behaviors {
       hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    


        keymap {
                compatible = "zmk,keymap";



                default_layer {
                        bindings = <
&trans &kp Q      &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &trans
&trans &hm LGUI A &hm LALT S &hm LCTRL D &hm LSHFT F &kp G &kp H &hm RSHFT J &hm RCTRL K &hm RALT L &hm RGUI SEMI &trans
&trans &kp Z      &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &trans
                               &kp A &lt SYMBOL TAB &kp A   &kp R &lt NAV BSPC &pk A
                        >;
                };



                 gaming_layer {
                        bindings = <
&trans &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &trans
&trans &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &trans
&trans &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &trans
            &kp A &kp A &kp A   &kp R &kp A &kp A
                        >;
                };



                symbol_layer {
                        bindings = <
&trans &kp SQT    &kp LT    &kp GT    &kp DQT   &kp HASH      &kp AT    &kp COLON &kp LBKT  &kp RBKT  &kp GRAVE &trans
&trans &kp EXCL   &kp MINUS &kp PLUS  &kp EQUAL &kp PRCNT     &kp AMPS  &kp SEMI  &kp LPAR  &kp RPAR  &kp DLLR  &trans
&trans &kp QMARK  &kp FSLH  &kp ASTRK &kp BSLH  &kp PIPE      &kp TILDE &kp UNDER &kp LBRC  &kp RBRC  &kp CARET &trans
                            &trans    &trans    &trans        &trans    &trans    &trans
                        >;
                };



                nav_layer {
                        bindings = <
&trans  &trans    &trans    &trans    &trans    &trans        &kp PG_UP  &kp LC(LEFT) &kp UP   &kp LC(RIGHT) &kp LC(BSPC) &trans
&trans  &trans    &trans    &trans    &trans    &kp CLCK      &kp PG_DN  &kp LEFT     &kp DOWN &kp RIGHT     &kp DEL      &trans
&trans  &kp LC(Z) &kp LC(X) &kp LC(C) &kp LC(V) &trans        &trans     &kp HOME     &trans   &kp END       &trans       &trans
                            &trans    &trans    &trans        &trans     &trans       &trans
 
                        >;
                };



                 adjust_layer {
                        bindings = <
&trans &none        &none        &none        &none        &none           &to QWERTY  &none        &none      &none        &none &none
&trans &bt BT_CLR   &none        &none        &none        &none           &tog GAMING &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP &none &none
&trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &none       &kp C_PREV   &kp C_PP   &kp C_NEXT   &none &none
                                 &none        &none        &none           &none       &none        &none
                        >;
                };



};
