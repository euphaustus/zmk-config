/*
My personal config now.
*/

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

// Layer definitions
#define BASE    0 //qwerty base layer
#define NAV     1 //arrow keys, home/end, scroll, etc
#define MOUSE   2 //mouse controls
#define MEDIA   3 //media
#define NUM     4 //numpad
#define SYM     5 //symbols
#define FUN     6 //function keys
#define GAMING  7 //gaming
#define ADJUST  8 //other/bluetooth
/ {

    // -------------------------------------------------------------------------
    // Activate ADJUST layer by pressing LOWER and RAISE simultaneously
    // -------------------------------------------------------------------------
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <NUM NAV>;
            then-layer = <ADJUST>;
        };
    };

    // -------------------------------------------------------------------------
    // Custom behaviors
    // -------------------------------------------------------------------------
    behaviors {

        /*
         * Home row mod hold-tap
         *
         * Using "balanced" flavor — this feels closest to QMK's default HRM
         * behavior. The key point: if you press AND RELEASE another key while
         * holding this key within tapping-term, it resolves as the MOD.
         * If you just tap it quickly alone, it sends the tap keycode.
         *
         * tapping-term-ms: how long until a hold is registered (ms)
         * quick-tap-ms:    if you tap within this window after a prior tap,
         *                  it sends the tap keycode immediately (good for
         *                  repeated letters like 'ss', 'ff' etc.)
         *
         * These values are a solid starting point — tune to taste.
         */
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ---------------------------------------------------------------------
        // QWERTY - Base layer
        // ,-----------------------------------------.                    ,-----------------------------------------.
        // |  `   |   1  |   2  |   3  |   4  |   5  |                    |   6  |   7  |   8  |   9  |   0  |  `   |
        // |------+------+------+------+------+------|                    |------+------+------+------+------+------|
        // | ESC  |   Q  |   W  |   E  |   R  |   T  |                    |   Y  |   U  |   I  |   O  |   P  | Bspc |
        // |------+------+------+------+------+------|                    |------+------+------+------+------+------|
        // | Tab  | GUI/A| ALT/S| CTL/D| SFT/F|   G  |-------.    ,-------|   H  | SFT/J| CTL/K| ALT/L| GUI/;|  '   |
        // |------+------+------+------+------+------|  MUTE |    | MPLAY |------+------+------+------+------+------|
        // |LShift|   Z  |   X  |   C  |   V  |   B  |-------|    |-------|   N  |   M  |   ,  |   .  |   /  |RShift|
        // `-----------------------------------------/       /     \      \-----------------------------------------'
        //               | LCTL | LALT | LGUI | LOWER| ENTER |     | SPACE| RAISE| RGUI | RALT | RCTL |
        // ---------------------------------------------------------------------
        qwerty_layer {
            display-name = "BASE";
            bindings = <
&kp GRAVE  &kp N1       &kp N2       &kp N3        &kp N4        &kp N5                           &kp N6    &kp N7        &kp N8        &kp N9        &kp N0           &kp GRAVE
&kp ESC    &kp Q        &kp W        &kp E         &kp R         &kp T                            &kp Y     &kp U         &kp I         &kp O         &kp P            &kp BSPC
&kp TAB    &hm LGUI A   &hm LALT S   &hm LCTRL D   &hm LSHFT F   &kp G                            &kp H     &hm RSHFT J   &hm RCTRL K   &hm RALT L    &hm RGUI SEMI    &kp SQT
&kp LSHFT  &kp Z        &kp X        &kp C         &kp V         &kp B    &kp C_MUTE   &kp C_PP   &kp N     &kp M         &kp COMMA     &kp DOT       &kp FSLH         &kp RSHFT
                          &kp LCTRL &kp LALT &lt MEDIA ESC &lt NUM TAB &lt MOUSE RET   &lt SYM SPACE &lt NAV BSPC &kp FUN DEL &kp RALT  &kp RCTRL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

        // ---------------------------------------------------------------------
        // GAMING - toggled from ADJUST layer
        // ,-----------------------------------------.                    ,-----------------------------------------.
        // | ESC  |   1  |   2  |   3  |   4  |   5  |                    |   6  |   7  |   8  |   9  |   0  |  `   |
        // |------+------+------+------+------+------|                    |------+------+------+------+------+------|
        // | Tab  |   Q  |   W  |   E  |   R  |   T  |                    |   Y  |   U  |   I  |   O  |   P  | Bspc |
        // |------+------+------+------+------+------|                    |------+------+------+------+------+------|
        // |LShift|   A  |   S  |   D  |   F  |   G  |-------.    ,-------|   H  |   J  |   K  |   L  |   ;  |  '   |
        // |------+------+------+------+------+------|  MUTE |    | MPLAY |------+------+------+------+------+------|
        // |LCtrl |   Z  |   X  |   C  |   V  |   B  |-------|    |-------|   N  |   M  |   ,  |   .  |   /  |RShift|
        // `-----------------------------------------/       /     \      \-----------------------------------------'
        //               | LGUI | LALT | LCTL | SPC  | ENTER |     | ENTER|QWERTY| RGUI | RALT | RCTL |
        // ---------------------------------------------------------------------
        gaming_layer {
            display-name = "GAMING";
            bindings = <
&kp ESC    &kp N1  &kp N2    &kp N3    &kp N4    &kp N5                          &kp N6   &kp N7    &kp N8     &kp N9    &kp N0    &kp GRAVE
&kp TAB    &kp Q   &kp W     &kp E     &kp R     &kp T                           &kp Y    &kp U     &kp I      &kp O     &kp P     &kp BSPC
&kp LSHFT  &kp A   &kp S     &kp D     &kp F     &kp G                           &kp H    &kp J     &kp K      &kp L     &kp SEMI  &kp SQT
&kp LCTRL  &kp Z   &kp X     &kp C     &kp V     &kp B  &kp C_MUTE  &kp C_PP    &kp N    &kp M     &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                   &kp LGUI  &kp LALT  &kp LCTRL &kp SPACE  &kp RET &kp RET     &tog GAMING &kp RGUI &kp RALT &kp RCTRL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

        // ---------------------------------------------------------------------
        // LOWER - Symbols and F-keys
        // ,-----------------------------------------.                    ,-----------------------------------------.
        // |  F1  |  F2  |  F3  |  F4  |  F5  |  F6  |                    |  F7  |  F8  |  F9  |  F10 |  F11 |  F12 |
        // |------+------+------+------+------+------|                    |------+------+------+------+------+------|
        // |      |   '  |   <  |   >  |   "  |   #  |                    |   @  |   :  |   [  |   ]  |   `  | Bspc |
        // |------+------+------+------+------+------|                    |------+------+------+------+------+------|
        // |      |   !  |   -  |   +  |   =  |   %  |-------.    ,-------|   &  |   ;  |   (  |   )  |   $  |   |  |
        // |------+------+------+------+------+------|       |    |       |------+------+------+------+------+------|
        // |      |   ?  |   /  |   *  |   \  |   |  |-------|    |-------|   ~  |   _  |   {  |   }  |   ^  |      |
        // `-----------------------------------------/       /     \      \-----------------------------------------'
        //               |      |      |      |      |       |     |      |      |      |      |      |
        // ---------------------------------------------------------------------
        symbol_layer {
            display-name = "SYM"
            bindings = <
&kp F1     &kp F2     &kp F3    &kp F4    &kp F5    &kp F6                        &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
&trans     &kp SQT    &kp LT    &kp GT    &kp DQT   &kp HASH                      &kp AT    &kp COLON &kp LBKT  &kp RBKT  &kp GRAVE &kp BSPC
&trans     &kp EXCL   &kp MINUS &kp PLUS  &kp EQUAL &kp PRCNT                     &kp AMPS  &kp SEMI  &kp LPAR  &kp RPAR  &kp DLLR  &kp PIPE
&trans     &kp QMARK  &kp FSLH  &kp ASTRK &kp BSLH  &kp PIPE  &trans    &trans   &kp TILDE &kp UNDER &kp LBRC  &kp RBRC  &kp CARET &trans
                      &trans    &trans    &trans    &trans    &trans      &trans   &trans    &trans    &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

        // ---------------------------------------------------------------------
        // RAISE - Navigation
        // ,-----------------------------------------.                    ,-----------------------------------------.
        // |      |      |      |      |      |      |                    |      |      |      |      |      |      |
        // |------+------+------+------+------+------|                    |------+------+------+------+------+------|
        // |      | Ins  | PScr | Menu |      |      |                    | PgUp |PrvWrd|  Up  |NxtWrd| DLine| Bspc |
        // |------+------+------+------+------+------|                    |------+------+------+------+------+------|
        // |      | LAlt | LCtl |LSHft |      | Caps |-------.    ,-------| PgDn | Left | Down | Right|  Del | Bspc |
        // |------+------+------+------+------+------|CtlTab |    |       |------+------+------+------+------+------|
        // |      | Undo |  Cut | Copy | Paste|      |-------|    |-------|      | Home |      |  End |      |      |
        // `-----------------------------------------/       /     \      \-----------------------------------------'
        //               |      |      |      |      |       |     |      |      |      |      |      |
        // ---------------------------------------------------------------------
        navigation_layer {
            display-name = "NAV";
            bindings = <
&trans  &trans    &trans     &trans      &trans       &trans                             &trans     &trans         &trans    &trans          &trans         &trans
&trans  &trans    &trans     &trans      &trans       &trans                             &kp PG_UP  &kp LC(LEFT)   &kp UP    &kp LC(RIGHT)   &kp LC(BSPC)   &kp BSPC
&trans  &trans    &trans     &trans      &trans       &kp CLCK                           &kp PG_DN  &kp LEFT       &kp DOWN  &kp RIGHT       &kp DEL        &kp BSPC
&trans  &kp LC(Z) &kp LC(X)  &kb LC(C)   &kp LC(V)    &trans   &kp LC(TAB)   &trans      &trans     &kp HOME       &trans    &kp END         &trans         &trans
                  &trans     &trans      &trans       &trans   &trans        &trans      &trans     &trans         &trans    &trans
            >;
            // Left encoder: Ctrl+Tab / Ctrl+Shift+Tab (tab switching) on RAISE
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

// TODO -- all other layers here, before adjust layer



        // ---------------------------------------------------------------------
        // ADJUST - RGB, BT, layer switching
        // ,-----------------------------------------.                    ,-----------------------------------------.
        // |      |      |      |      |      |      |                    |      |      |      |      |      |      |
        // |------+------+------+------+------+------|                    |------+------+------+------+------+------|
        // | Reset| spd+ | val+ | sat+ | hue+ | eff+ |                    |QWERTY|      |      |      |      |      |
        // |------+------+------+------+------+------|                    |------+------+------+------+------+------|
        // |ExtPwr| spd- | val- | sat- | hue- | eff- |-------.    ,-------|GAMING| VOLD | MUTE | VOLU |      |      |
        // |------+------+------+------+------+------|RGBtog |    |       |------+------+------+------+------+------|
        // |BT_CLR| BT0  | BT1  | BT2  | BT3  | BT4  |-------|    |-------|      | PREV | PLAY | NEXT |      |      |
        // `-----------------------------------------/       /     \      \-----------------------------------------'
        //               |      |      |      |      |       |     |      |      |      |      |      |
        // ---------------------------------------------------------------------
        adjust_layer {
            display-name = "ADJUST";
            bindings = <
&none           &none            &none            &none            &none            &none                                    &none       &none       &none     &none       &none  &none
&sys_reset      &rgb_ug RGB_SPI  &rgb_ug RGB_BRI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_EFF                          &to QWERTY  &none       &none     &none       &none  &none
&ext_power EP_OFF &rgb_ug RGB_SPD &rgb_ug RGB_BRD &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_EFR                          &tog GAMING &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP &none &none
&bt BT_CLR      &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4  &rgb_ug RGB_TOG  &none    &none       &kp C_PREV  &kp C_PP  &kp C_NEXT  &none  &none
                                 &none            &none            &none            &none          &none            &none    &none       &none       &none     &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

    };
};
